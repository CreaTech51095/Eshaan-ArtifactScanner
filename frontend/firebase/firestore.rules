rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: all authenticated users can read (needed for looking up users by email in groups)
    // Only the user themselves or admins can write/update
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && 
        (request.auth.uid == userId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow delete: if false; // Never allow hard deletes
    }
    
    // Groups: members can read, admins and group creators can manage
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         resource.data.createdBy == request.auth.uid);
      allow delete: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         resource.data.createdBy == request.auth.uid);
    }
    
    // Group Members: Allow read for authenticated users
    // Allow create/update/delete for admins or group creators
    match /groupMembers/{membershipId} {
      allow read: if request.auth != null;
      // Allow create for admins or group creators
      allow create: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid);
      // Allow update/delete for admins or group creators
      allow update, delete: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.createdBy == request.auth.uid);
    }
    
    // Group Join Requests: users can create their own, group admins can manage
    match /groupRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         resource.data.userId == request.auth.uid);
    }
    
    // Artifacts: accessible by authenticated users, group filtering handled in app
    match /artifacts/{artifactId} {
      // Read: all authenticated users (group filtering done in application)
      allow read: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'archaeologist', 'researcher', 'guest']);
      
      // Create: admins and archaeologists
      allow create: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'archaeologist']);
      
      // Update: global admins or artifact creator
      allow update: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         resource.data.createdBy == request.auth.uid);
      
      // Delete: global admins or artifact creator
      allow delete: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         resource.data.createdBy == request.auth.uid);
    }
    
    // Photos: same rules as artifacts
    match /photos/{photoId} {
      allow read: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'archaeologist', 'researcher', 'guest']);
      allow create: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'archaeologist']);
      allow update: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         resource.data.createdBy == request.auth.uid);
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Role Requests: users can create/read their own, admins can read/update all
    match /roleRequests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Artifact Comments: authenticated users can create, author can edit/delete
    match /artifactComments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow delete: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Sync logs: users can only access their own
    match /syncLogs/{logId} {
      allow read, write: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
  }
}
